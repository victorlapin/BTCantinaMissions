<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>BTCantinaMissions</AssemblyName>
    <RootNamespace>BTCantinaMissions</RootNamespace>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Lets dotnet build target .NET Framework without installed targeting packs (VS Code friendly) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Direct access to private members of the game assembly (no AccessTools reflection) -->
  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" Version="2.3.2" />
    <Publicize Include="Assembly-CSharp" />
    <Publicize Include="BTSimpleMechAssembly" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ModsDir)\ModTek\lib\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(ManagedDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="InControl">
      <HintPath>$(ManagedDir)\InControl.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="JwTweaks">
      <HintPath>$(ModsDir)\JwTweaks\JwTweaks.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CustomComponents">
      <HintPath>$(ModsDir)\CustomComponents\CustomComponents.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CustomSalvage">
      <HintPath>$(ModsDir)\CustomSalvage\CustomSalvage.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LewdableTanks">
      <HintPath>$(ModsDir)\LewdableTanks\LewdableTanks.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BTSimpleMechAssembly">
      <HintPath>BTSimpleMechAssembly\BTSimpleMechAssembly.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <!-- Optional deployment: dotnet build -p:DeployDir="D:\path\to\Mods\BTCantinaMissions" -->
  <Target Name="Deploy" AfterTargets="Build" Condition="'$(DeployDir)' != ''">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployDir)" />
    <Message Importance="high" Text="Deployed $(TargetFileName) to $(DeployDir)" />
  </Target>

</Project>
